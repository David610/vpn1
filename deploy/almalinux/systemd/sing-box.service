[Unit]
Description=sing-box compatibility data plane (VLESS+REALITY, Hysteria2)
Documentation=https://sing-box.sagernet.org/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sing-box
Group=sing-box
ExecStartPre=/usr/local/bin/sing-box check -c /etc/vpn/compat/sing-box/config.json
ExecStart=/usr/local/bin/sing-box run -c /etc/vpn/compat/sing-box/config.json
Restart=on-failure
RestartSec=2
LimitNOFILE=65535
# TasksMax intentionally left at systemd's own default (a percentage of
# system-wide pid_max) rather than a hand-picked number here — that
# default is already generous relative to <=10 users' worth of
# connections and scales with host size, which a fixed constant would not.

# Checkpoint 7 §12: a soft, proportional memory governor — NOT a hard
# cap. `MemoryHigh` makes the kernel reclaim this cgroup's page
# cache/reclaimable memory once it's exceeded, throttling the service
# under real memory pressure instead of letting a runaway/leaking
# process (or a burst of legitimate large transfers across <=10 users)
# consume the whole host and destabilize sshd/other services. It is
# deliberately NOT `MemoryMax` (a hard limit that OOM-kills the service
# on breach) — there is no single safe fixed byte value across the range
# of VPS sizes this project supports, and a hard cap that's wrong for a
# given host would turn a memory-pressure event into a self-inflicted
# outage. 75% is conservative headroom on even a small (512MB-1GB) VPS;
# `vpn doctor --performance` reports current RAM/swap for operators who
# want to size this down further for a specific host.
MemoryHigh=75%

# Modest CPU scheduling priority bump, not real-time scheduling. On a
# 1-2 vCPU host, sing-box's Hysteria2/QUIC inbound is latency-sensitive
# userspace packet processing that competes with everything else on the
# box (nginx, sshd, cron, the admin/subscription binaries); upstream
# Hysteria guidance (https://v2.hysteria.network/docs/advanced/Performance/)
# explicitly cautions to raise priority moderately and only after
# testing, not to jump to SCHED_RR/FIFO, which could starve other
# processes on a shared host. -5 is deliberately conservative — enough
# to matter under contention, not enough to approach realtime.
Nice=-5

# Binding 443/tcp+udp requires CAP_NET_BIND_SERVICE, not root — grant only
# that capability rather than running as root (spec §32).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. Documented exceptions:
#  - ProtectSystem=strict + explicit ReadOnlyPaths for the config dir
#    (sing-box only needs to *read* config/certs, never write there).
#  - No ProtectHome restriction needed (service user has no home).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/etc/vpn/compat
# AF_NETLINK is required: sing-box opens a netlink socket to subscribe
# to route/interface change notifications (its network monitor, used
# for outbound-interface auto-detection) even without TUN configured.
# Without it here, the kernel rejects that socket() call with EAFNOSUPPORT
# ("address family not supported by protocol") and sing-box.service
# fails to start at all — caught on a real AlmaLinux install.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
